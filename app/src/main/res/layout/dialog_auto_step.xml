<?xml version="1.0" encoding="utf-8"?>
<!--
  添加一个「自动变分类」的时间点：
  上面选目标分类（四象限），下面选什么时候变（带「几天之后」的快捷按钮）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:text="@string/label_auto_target_category"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:columnCount="2"
            android:rowCount="2">

            <!-- 位置：左上 重要不紧急 / 右上 重要紧急 / 左下 不重要不紧急 / 右下 不重要紧急 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cat_0"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="46dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_dot"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cat_1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="46dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_dot"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cat_2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="46dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_dot"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cat_3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="46dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_dot"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="9dp" />
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:text="@string/label_auto_when"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_auto_time"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:gravity="start|center_vertical"
            android:minHeight="48dp"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_alarm"
            app:iconGravity="textStart"
            tools:text="11月29日 08:00" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:text="@string/label_auto_quick"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auto_in1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="44dp"
                android:text="@string/auto_in_1day"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auto_in3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:minHeight="44dp"
                android:text="@string/auto_in_3days"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auto_in7"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/auto_in_7days"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="4dp"
            android:text="@string/tip_auto_category"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
