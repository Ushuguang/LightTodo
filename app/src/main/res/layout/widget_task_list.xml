<?xml version="1.0" encoding="utf-8"?>
<!-- 待办清单 / 某个组的任务 / 某个类的任务，三个小组件共用这一个布局。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_text_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_text_sub"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_refresh"
            android:src="@drawable/w_ic_refresh" />

        <ImageView
            android:id="@+id/w_add"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_new_task"
            android:src="@drawable/w_ic_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/w_line" />

    <!-- 任务区：每加进来的是一「行」——放得开的两条并排一栏，放不开的一条独占整行 -->
    <LinearLayout
        android:id="@+id/w_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_empty"
        android:textColor="@color/w_text_sub"
        android:textSize="12sp"
        android:visibility="gone" />


</LinearLayout>
