<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件里的「并排一行」：左边一条任务、右边一条任务。
     两条都放得开才用这个；放不开的任务用 widget_item 独占整行。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/w_left_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/w_left_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/cd_check"
            android:src="@drawable/w_ic_todo_not_important_not_urgent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_left_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_text_title"
                android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:textSize="13sp" />

            <TextView
                android:id="@+id/w_left_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_text_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_right_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/w_right_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/cd_check"
            android:src="@drawable/w_ic_todo_not_important_not_urgent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_right_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_text_title"
                android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:textSize="13sp" />

            <TextView
                android:id="@+id/w_right_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_text_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
