<?xml version="1.0" encoding="utf-8"?>
<!-- 允许 FileProvider 分享应用私有目录里的下载文件（更新用的 APK） -->
<paths>
    <external-files-path
        name="external_downloads"
        path="Download" />
    <files-path
        name="internal_files"
        path="." />
    <!-- 题目配图（在 files/photos/ 下面） -->
    <files-path
        name="question_photos"
        path="photos/" />
    <!-- 相机拍完照的临时文件（在 cache/camera/ 下面） -->
    <cache-path
        name="camera_cache"
        path="camera/" />
</paths>
